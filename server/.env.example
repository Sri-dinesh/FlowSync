# Server-only credentials. Never use these values in NEXT_PUBLIC_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-server-secret-or-service-role-key

# Comma-separated browser origins; local development defaults are included.
CORS_ORIGINS=http://localhost:3000
SIGNAL_RED_DURATION=3.0
