package-lock.json
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/

# Build Output
dist/
build/

# Turbo & Tooling Caches
.turbo/
.cache/
.expo/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing & E2E
coverage/
playwright-report/
test-results/
blob-report/
screenshots/
e2e-artifacts/

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Vercel Deployment
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Storybook (if generated)
storybook-static/

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Prisma Generated Client
/src/generated/prisma